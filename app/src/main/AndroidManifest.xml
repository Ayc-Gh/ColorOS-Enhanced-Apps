<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.android.systemui" />
        <package android:name="com.oplus.aod" />
        <package android:name="com.oplus.cast" />
        <package android:name="com.oplus.gesture" />
        <package android:name="com.oplus.trafficmonitor" />
        <package android:name="com.oplus.gleanerservice" />
    </queries>
    <application android:name=".ModuleApplication" android:allowBackup="false"
        android:icon="@drawable/ic_module" android:label="@string/app_name"
        android:description="@string/module_description" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity android:name=".CastSettingsActivity" android:exported="false" />
        <activity android:name=".GestureSettingsActivity" android:exported="false" />
        <activity android:name=".WindowSettingsActivity" android:exported="false" />
        <activity android:name=".NetworkSettingsActivity" android:exported="false" />
        <activity android:name=".AimemorySettingsActivity" android:exported="false" />
        <activity android:name="com.op.aod.enhance.ui.MainActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name="com.op.aod.enhance.ui.BrightnessActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name="com.op.aod.enhance.ui.FeaturesActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name="com.op.aod.enhance.ui.RuntimeStatusActivity" android:exported="false" />
    </application>
</manifest>
